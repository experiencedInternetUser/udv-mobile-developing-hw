<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VacationSurvey.MainPage"
             Title="Анкета">

    <ScrollView>
        <VerticalStackLayout x:Name="RootStack"
                              Padding="20"
                              Spacing="16">

            <Grid x:Name="HeaderGrid"
                  RowDefinitions="Auto,Auto,Auto"
                  ColumnDefinitions="100,*"
                  RowSpacing="10"
                  ColumnSpacing="10">

                <Label x:Name="TitleLabel"
                       Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                       Text="Анкета: твой идеальный отпуск"
                       FontSize="24"
                       FontAttributes="Bold"
                       Margin="0,0,0,10" />

                <Label x:Name="NameLabel"
                       Grid.Row="1" Grid.Column="0"
                       Text="Имя:"
                       FontSize="16"
                       FontAttributes="Italic"
                       Margin="0,0,5,0"
                       VerticalOptions="Center" />

                <Entry x:Name="NameEntry"
                       Grid.Row="1" Grid.Column="1"
                       Placeholder="Введите ваше имя"
                       Keyboard="Text"
                       MaxLength="30"
                       Margin="0,2"
                       TextChanged="OnRequiredFieldChanged" />

                <Label x:Name="EmailLabel"
                       Grid.Row="2" Grid.Column="0"
                       Text="Email:"
                       FontSize="16"
                       FontAttributes="Italic"
                       Margin="0,0,5,0"
                       VerticalOptions="Center" />

                <Entry x:Name="EmailEntry"
                       Grid.Row="2" Grid.Column="1"
                       Placeholder="Введите email"
                       Keyboard="Email"
                       MaxLength="50"
                       Margin="0,2"
                       TextChanged="OnRequiredFieldChanged" />
            </Grid>

            <Editor x:Name="CommentsEditor"
                    Placeholder="Расскажите, что для вас важно в отпуске"
                    AutoSize="TextChanges"
                    MaxLength="200"
                    HeightRequest="80"
                    Margin="0,5" />

            <Picker x:Name="DestinationPicker"
                    Title="Выберите направление"
                    Margin="0,5">
                <Picker.Items>
                    <x:String>Горы</x:String>
                    <x:String>Море</x:String>
                    <x:String>Город</x:String>
                    <x:String>Лес</x:String>
                </Picker.Items>
            </Picker>

            <!-- ======= RadioButtons ======= -->
            <Label Text="Бюджет поездки:" FontSize="16" FontAttributes="Bold" />
            <HorizontalStackLayout x:Name="BudgetStack" Spacing="15" Margin="0,0,0,5">
                <RadioButton x:Name="BudgetEconomy"
                             Content="Эконом"
                             GroupName="BudgetGroup"
                             Value="Эконом"
                             IsChecked="True" />
                <RadioButton x:Name="BudgetStandard"
                             Content="Стандарт"
                             GroupName="BudgetGroup"
                             Value="Стандарт" />
                <RadioButton x:Name="BudgetLuxury"
                             Content="Люкс"
                             GroupName="BudgetGroup"
                             Value="Люкс" />
            </HorizontalStackLayout>

            <Label Text="Интересы:" FontSize="16" FontAttributes="Bold" />
            <HorizontalStackLayout Spacing="20" Margin="0,0,0,5">
                <HorizontalStackLayout Spacing="5">
                    <CheckBox x:Name="SightseeingCheck"
                              IsChecked="False"
                              Color="Green" />
                    <Label Text="Экскурсии" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="5">
                    <CheckBox x:Name="BeachCheck"
                              IsChecked="False"
                              Color="DodgerBlue" />
                    <Label Text="Пляжный отдых" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </HorizontalStackLayout>

            <HorizontalStackLayout Spacing="10" Margin="0,5">
                <Label Text="Подписаться на рассылку:" VerticalOptions="Center" />
                <Switch x:Name="NewsletterSwitch"
                        IsToggled="False"
                        OnColor="SeaGreen" />
            </HorizontalStackLayout>

            <HorizontalStackLayout Spacing="10" Margin="0,5">
                <Label Text="Дата поездки:" VerticalOptions="Center" />
                <DatePicker x:Name="TripDatePicker"
                            Format="dd.MM.yyyy" />
            </HorizontalStackLayout>

            <HorizontalStackLayout Spacing="10" Margin="0,5">
                <Stepper x:Name="DaysStepper"
                         Minimum="1"
                         Maximum="30"
                         Value="7"
                         Increment="1"
                         ValueChanged="OnDaysStepperChanged" />
                <Label x:Name="DaysLabel"
                       Text="{Binding Source={x:Reference DaysStepper}, Path=Value, Mode=OneWay, StringFormat='Дней: {0:F0}'}"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Image x:Name="VacationImage"
                   Source="https://picsum.photos/id/1016/400/200"
                   Aspect="AspectFill"
                   HeightRequest="150"
                   Margin="0,5" />

            <HorizontalStackLayout Spacing="15" Margin="0,10">
                <Button x:Name="ShowResultButton"
                        Text="Показать результат"
                        IsEnabled="False"
                        Clicked="OnShowResultClicked" />
                <Button x:Name="ClearButton"
                        Text="Очистить"
                        Clicked="OnClearClicked" />
            </HorizontalStackLayout>

            <Label x:Name="ResultLabel"
                   Text=""
                   FontSize="15"
                   IsVisible="False"
                   Margin="0,5" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
